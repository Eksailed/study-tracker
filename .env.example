# Домен без https://, пути и номера порта.
DOMAIN=study.example.com
HTTP_PORT=80
HTTPS_PORT=443
BIND_ADDRESS=0.0.0.0
# Измени все три значения, если эта подсеть занята другим Docker-проектом.
BACKEND_SUBNET=172.30.0.0/24
BACKEND_POOL=172.30.0.128/25
PROXY_IP=172.30.0.2
TRACKER_IMAGE=study-tracker:local
# Необязательно. Реальный токен хранится только в локальном .env, не в Git.
TELEGRAM_BOT_TOKEN=
